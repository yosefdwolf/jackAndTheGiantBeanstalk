OPENAI_API_KEY=
# Image model: gpt-image-2.5-flare kept faces best and costs ~$0.02 per scene at medium
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=medium
# Cheap vision model used to describe the face and to judge scenes in eval
VISION_MODEL=gpt-4.1-mini
# 1 = no OpenAI calls, placeholder images (free UI testing)
MOCK=0

# Required: password people must enter to make a book. Set the real value in .env / Railway, never here.
APP_PASSWORD=

# Google sign-in (everyone signs in). Redirect URI locally: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string that signs the sign-in cookie
SESSION_SECRET=
# Comma-separated emails allowed on the admin site, with no daily limit
ADMIN_EMAILS=
# What one book costs, in cents (admins and the unlimited list are free)
BOOK_PRICE_CENTS=99
# 1 = sign in on localhost without Google (only while GOOGLE_CLIENT_ID is empty)
DEV_LOGIN=0
# Optional: lets an admin pick Agnes for their own test books
AGNES_API_KEY=

# Stripe test mode (class sandbox)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email to the admins when someone asks for a refund (Gmail: smtp.gmail.com + an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAILS=
